# Backend Environment Variables
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticket_booking_db?schema=public"

# Auth
JWT_SECRET="super-secret-jwt-signing-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# App & Client URL
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Hold & Waitlist Settings
DEFAULT_SEAT_HOLD_TTL_MINUTES=10
DEFAULT_WAITLIST_OFFER_TTL_MINUTES=15
SWEEP_INTERVAL_SECONDS=15

# Email Dispatch
EMAIL_PROVIDER="console" # 'console' | 'smtp' | 'resend'
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Ticket Booking System <no-reply@ticketbooking.com>"
RESEND_API_KEY=""
