# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_booking_db?schema=public
SEED_DATABASE=true

# Frontend API base URL (Optional, defaults to relative /api for unified Vite/Express container)
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# SendGrid / Email Delivery Configuration
SENDGRID_API_KEY=
EMAIL_FROM_NAME="Velocity Pass"
EMAIL_FROM_ADDRESS=

# Alternative SMTP Configuration (Optional fallback)
EMAIL_PROVIDER=sendgrid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Authentication & Application Settings
JWT_SECRET=
SEAT_HOLD_TTL_MINUTES=10
DEFAULT_SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
DEFAULT_WAITLIST_OFFER_TTL_MINUTES=15
SWEEP_INTERVAL_SECONDS=15

